void handleTouch() {
  uint16_t x, y; if (!tft.getTouch(&x, &y) || millis() - uiLastTouch < 220) return; uiLastTouch = millis();
  if (screenPage == PAGE_PLAYER) {
    if (y < 38 && x >= 416) { screenPage = PAGE_TOOLS; redrawScreen(); return; }
    if (y < 38 && x >= 350) { stopLocalMetaTask(); appMode=APP_HOME; drawMainMenu(); return; }
    if (y < 38) return;
    if (y < 245) return;
    if (x < 80) {cancelPendingAutoPlay();playNativeStation(nativeStation - 1);}
    else if (x < 156) {cancelPendingAutoPlay();if (nativePlaying || nativeConnecting) stopNative(); else playNativeStation(nativeStation);}
    else if (x < 232) {cancelPendingAutoPlay();playNativeStation(nativeStation + 1);}
    else if (x < 308) changeVolume(-5);
    else if (x < 384) changeVolume(5);
    else { screenPage = PAGE_STATIONS; redrawScreen(); }
  } else if (screenPage == PAGE_STATIONS) {
    if (y < 32 && x > 390) { screenPage = PAGE_PLAYER; redrawScreen(); return; }
    if (y >= 34) { int col = x / 158, row = (y - 34) / 69, id = row * 3 + col; if (id < STATION_COUNT) { cancelPendingAutoPlay();screenPage = PAGE_PLAYER; playNativeStation(id); } }
  } else if (screenPage == PAGE_TOOLS) {
    if (y < 32 && x > 390) { screenPage = PAGE_PLAYER; redrawScreen(); return; }
    int col = x / 160;
    if (y >= 36 && y < 98) {
      if (col == 0) { metaPriorityRequest = nativeStation; uiLastMeta = 0; }
      else if (col == 1) { nativeFast = !nativeFast; prefs.putBool("fast", nativeFast); buildNativeSources(nativeStation); }
      else { nativeAutoQuality = !nativeAutoQuality; prefs.putBool("autoq", nativeAutoQuality); }
    } else if (y >= 98 && y < 162) {
      if (col == 0) {
        uint32_t left = sleepUntilMs ? (sleepUntilMs-millis())/60000UL : 0;
        uint8_t next = left < 10 ? 15 : left < 23 ? 30 : left < 45 ? 60 : left < 75 ? 90 : 0;
        sleepUntilMs = next ? millis() + (uint32_t)next*60000UL : 0;
      } else if (col == 1) { screenPage=PAGE_BRIGHTNESS; }
      else { nativeCarMode=!nativeCarMode; prefs.putBool("car",nativeCarMode); }
    } else if (y >= 162 && y < 225) {
      if (col == 0) { screenPage=PAGE_SCHEDULE; scheduleStation=nativeStation; schedulePriorityRequest=scheduleStation; }
      else if (col == 1) screenPage=PAGE_DIAG;
      else { rotation180=!rotation180; prefs.putBool("rot180",rotation180); delay(350); ESP.restart(); }
    } else if (y >= 225 && y < 289) {
      if (col == 0) { prefs.remove(rotation180 ? "touch3r" : "touch3n"); delay(350); ESP.restart(); }
      else if (col == 1) { wifiConfigScreen(); return; }
      else { stopLocalMetaTask(); appMode=APP_HOME; drawMainMenu(); return; }
    }
    redrawScreen();
  } else if (screenPage == PAGE_BRIGHTNESS) {
    if (y < 32 && x > 390) { screenPage=PAGE_TOOLS; redrawScreen(); return; }
    if (y >= 78 && y <= 158) {
      if (x < 108) { autoBrightness=true; prefs.putBool("autobri",true); }
      else if (x < 194) applyManualBrightness(25);
      else if (x < 280) applyManualBrightness(50);
      else if (x < 366) applyManualBrightness(75);
      else applyManualBrightness(100);
      redrawScreen(); return;
    }
  } else if (screenPage == PAGE_SCHEDULE) {
    if (y < 32 && x > 390) { screenPage=PAGE_TOOLS; redrawScreen(); return; }
    if (y > 268) {
      if (x < 160) scheduleStation=(scheduleStation+STATION_COUNT-1)%STATION_COUNT;
      else if (x > 320) scheduleStation=(scheduleStation+1)%STATION_COUNT;
      schedulePriorityRequest=scheduleStation; redrawScreen();
    }
  } else if (y < 32 && x > 390) { screenPage = PAGE_TOOLS; redrawScreen(); }
}


String cydKeyboard(const String& title,const String& initial,bool passwordMode){
  String value=initial; bool upper=false; bool symbols=false;
  const char* lowerRows[]={"1234567890","qwertyuiop","asdfghjkl","zxcvbnm"};
  const char* upperRows[]={"1234567890","QWERTYUIOP","ASDFGHJKL","ZXCVBNM"};
  const char* symRows[]={"1234567890","!@#$%^&*()","_-+=[]{}",".,:;?/\\\\"};
