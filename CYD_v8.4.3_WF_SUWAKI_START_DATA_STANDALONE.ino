void weatherChartTempHum(int x,int y,int w,int h){
  const uint16_t bg=UI_CARD;
  tft.fillRoundRect(x,y,w,h,9,bg);
  tft.drawRoundRect(x,y,w,h,9,0x1B8D);
  if(weather.count<2)return;

  float mn=weather.h[0].temp,mx=mn;
  for(int i=1;i<weather.count;i++){
    mn=min(mn,weather.h[i].temp);
    mx=max(mx,weather.h[i].temp);
  }
  mn=floorf(mn-1.0f);
  mx=ceilf(mx+1.0f);
  if(mx-mn<3.0f)mx=mn+3.0f;

  tft.setTextDatum(top_left);
  tft.setTextSize(1);
  tft.setTextColor(0xFFE0);
  tft.drawString("TEMP C",x+6,y+4);
  tft.setTextDatum(top_right);
  tft.setTextColor(0x05FF);
  tft.drawString("WILG %",x+w-6,y+4);

  int gx=x+28,gy=y+22,gw=w-56,gh=h-38;
  for(int k=0;k<4;k++){
    int yy=gy+k*gh/3;
    tft.drawFastHLine(gx,yy,gw,0x1084);
    float tv=mx-(mx-mn)*k/3.0f;
    int hv=100-k*33;
    tft.setTextDatum(middle_right);
    tft.setTextColor(0xFBE0);
    tft.drawString(String(tv,0),gx-3,yy);
    tft.setTextDatum(middle_left);
    tft.setTextColor(0x05FF);
    tft.drawString(String(hv),gx+gw+3,yy);
  }
  for(int i=1;i<weather.count;i++){
    int x1=gx+(i-1)*gw/(weather.count-1),x2=gx+i*gw/(weather.count-1);
    int yt1=gy+(int)((mx-weather.h[i-1].temp)/(mx-mn)*gh);
    int yt2=gy+(int)((mx-weather.h[i].temp)/(mx-mn)*gh);
    int yh1=gy+(100-weather.h[i-1].humidity)*gh/100;
    int yh2=gy+(100-weather.h[i].humidity)*gh/100;
    tft.drawLine(x1,yt1,x2,yt2,0xFBE0);
    tft.drawLine(x1,yh1,x2,yh2,0x05FF);
  }
  for(int i=0;i<weather.count;i+=3){
    int xx=gx+i*gw/(weather.count-1);
    tft.setTextDatum(top_center);
    tft.setTextColor(0x9D7F);
    tft.drawString(weather.h[i].time,xx,y+h-14);
  }
  tft.setTextDatum(top_left);
}

