  uint32_t ntpAt=millis();while(time(nullptr)<100000&&millis()-ntpAt<1800UL)delay(40);
  drawStartupDataProgress(18,"CZAS",time(nullptr)>100000?"Synchronizacja OK":"uzupelni sie w tle");

  String boot=m0HttpGet("/api/cyd/bootstrap?city="+String(WEATHER_KEYS[weatherCity])+"&lat="+String(m0AprsCenterLat,6)+"&lon="+String(m0AprsCenterLon,6));
  bool bootOk=m0JsonValue(boot,"ok")=="true";bool serverOk=bootOk;
  drawStartupDataProgress(32,"SERWER M0NKA",serverOk?"polaczenie OK":("pominieto: "+m0LastError));

  String w;bool weatherOk=false;
  if(bootOk&&m0JsonValue(boot,"weather_ok")=="true")w=String("{\"ok\":true,\"city\":\"")+m0JsonValue(boot,"weather_city")+"\",\"updated\":\""+m0JsonValue(boot,"weather_updated")+"\",\"current\":\""+m0JsonValue(boot,"weather_current")+"\",\"hours\":\""+m0JsonValue(boot,"weather_hours")+"\",\"days\":\""+m0JsonValue(boot,"weather_days")+"\"}";
  if(!w.length())w=m0HttpGet("/api/weather?city="+String(WEATHER_KEYS[weatherCity]));
  if(w.length()){parseWeatherPayload(w);weatherOk=weather.refreshedAt>0;}
  if(!weatherOk){String d=directWeatherGet();weatherOk=parseDirectWeather(d);}
  drawStartupDataProgress(48,"POGODA",weatherOk?"dane gotowe":"uzupelni sie w tle");

  if(bootOk){String packed=m0JsonValue(boot,"spots");m0ParseServerList(packed,M0_SPOTS);m0SpotsStatus="PORTABLE: "+String(m0SpotCount)+" z pakietu startowego";}
  else m0RefreshDataPage(M0_SPOTS);
  drawStartupDataProgress(62,"SPOTY",m0SpotCount?(String(m0SpotCount)+" pozycji gotowych"):"uzupelnia sie pozniej");

  String ap=bootOk?boot:m0HttpGet("/api/aprs-cyd?lat="+String(m0AprsCenterLat,6)+"&lon="+String(m0AprsCenterLon,6)+"&radius=250&max_age=360");
  if(ap.length())m0ParseAprsCompact(ap);
  if(imageStorageReady&&SPIFFS.exists("/aprsmap.jpg")){m0AprsMapReady=true;m0AprsMapDirty=false;}
  drawStartupDataProgress(74,"APRS",String(m0AprsCount)+" stacji | "+(m0AprsMapReady?"mapa z pamieci":"mapa po wejsciu"));

  uint32_t logoBudget=millis()+22000UL;uint8_t ready=0;
  for(uint8_t i=0;i<STATION_COUNT;i++){
    if(SPIFFS.exists(logoPath(i)))ready++;
    else if((int32_t)(millis()-logoBudget)<0){drawStartupDataProgress(76+(uint8_t)((uint16_t)i*17/STATION_COUNT),"LOGOTYPY STACJI",String(i+1)+" / "+String(STATION_COUNT));ensureStationLogo(i);if(SPIFFS.exists(logoPath(i)))ready++;}
  }
  drawStartupDataProgress(94,"LOGA I OKLADKI",String(ready)+" logo | ostatnie okladki zachowane");
  drawStartupDataProgress(100,"GOTOWE","HOME uruchamia sie z przygotowanymi danymi");delay(650);
}

