// Dwie linie w kafelku. Druga dostaje "..." tylko wtedy, gdy tekst nadal
// nie miesci sie po podziale. Dzielimy w pierwszej kolejnosci na spacji.
void tileText2(const String& source, uint8_t maxChars, String& line1, String& line2) {
  String s=lcdSafe(source);s.trim();line1="";line2="";
  if(s.length()<=maxChars){line1=s;return;}
  int cut=maxChars;
  while(cut>0&&s[cut]!=' ')cut--;
  if(cut<4)cut=maxChars;
  line1=s.substring(0,cut);line1.trim();
  s=s.substring(cut);s.trim();
  if(s.length()>maxChars){line2=s.substring(0,maxChars>3?maxChars-3:maxChars)+"...";}
  else line2=s;
}

