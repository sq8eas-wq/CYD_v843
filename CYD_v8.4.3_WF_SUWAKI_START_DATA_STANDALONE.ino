  if (downloadJpegToFlash(stationLogoDownloadUrl(id), logoPath(id), 50000)) imageScreenDirty = true;
}

void ensureArtwork(uint8_t id,const String& title){
  if(!imageStorageReady||id>=STATION_COUNT||!title.length())return;
  String song=cleanSongForArtwork(title);
  if(!song.length()){artworkState=ART_NOT_FOUND;imageScreenDirty=true;return;}
  if(cachedArtTitle[id]==song&&SPIFFS.exists(artPath(id))){artworkState=ART_READY;return;}
  if(id!=nativeStation)return;

  if(pendingArtworkTitle!=song){
    pendingArtworkTitle=song; pendingArtworkUrl=""; pendingArtworkSince=millis();
    lastArtworkAttemptAt=0; artworkState=ART_SEARCH; artworkAttempts=0; imageScreenDirty=true;
    return;
  }

  // Szukanie adresu jest lekkie i nie czeka na bufor audio.
  if(!pendingArtworkUrl.length()){
    if(millis()-pendingArtworkSince<450UL)return;
    if(lastArtworkAttemptAt && millis()-lastArtworkAttemptAt<1400UL)return;
    lastArtworkAttemptAt=millis(); artworkState=ART_SEARCH; imageScreenDirty=true;
    pendingArtworkUrl=findArtworkUrl(song);
    if(!pendingArtworkUrl.length()){
      artworkAttempts++; artworkState=(artworkAttempts>=3)?ART_NOT_FOUND:ART_RETRY; imageScreenDirty=true;
      return;
    }
    artworkAttempts=0;
  }

  // Daj audio najwyzej ok. 2 s na ustabilizowanie. Potem probuj pobrac,
  // ale sam downloader nadal przerwie transfer przy realnym ryzyku glodzenia bufora.
  if(nativePlaying && bufferRisk!=BUFFER_SAFE && bufferRisk!=BUFFER_LEARNING && millis()-pendingArtworkSince<2200UL){
    artworkState=ART_WAIT_BUFFER; imageScreenDirty=true; return;
  }
  if(lastArtworkAttemptAt && millis()-lastArtworkAttemptAt<650UL)return;
  lastArtworkAttemptAt=millis(); artworkState=ART_DOWNLOAD; imageScreenDirty=true;
  if(downloadJpegToFlash(pendingArtworkUrl,artPath(id),50000)){
    cachedArtTitle[id]=song;prefs.putString(("art"+String(id)).c_str(),song);
    pendingArtworkTitle="";pendingArtworkUrl="";artworkState=ART_READY;artworkAttempts=0;imageScreenDirty=true;
  } else {
    artworkAttempts++; artworkState=ART_RETRY; imageScreenDirty=true;
    if(artworkAttempts>=2) pendingArtworkUrl="";
  }
}

void localMetaTask(void*) {
  // v8.2: zadanie istnieje tylko podczas stabilnego odtwarzania Radia.
  // W poprzednich wersjach 9 kB stosu bylo zajete od startu CYD do restartu.
  vTaskDelay(pdMS_TO_TICKS(400));
  uint32_t listAt=0, priorityAt=0, scheduleAt=0;
  uint8_t logoCursor=0, scheduleCursor=0;
  for(;;){
    if(localMetaTaskStop || appMode!=APP_RADIO || !nativePlaying){
      localMetaTaskHandle=nullptr;
      vTaskDelete(nullptr);
      return;
    }
    // Najpierw musi rzeczywiscie grac stabilny strumien Radia.
    if(nativeConnecting){
      vTaskDelay(pdMS_TO_TICKS(350));
      continue;
    }
    bool net=WiFi.status()==WL_CONNECTED;
    bool normalOk=bufferAllowsBackground(false);
    bool heavyOk=bufferAllowsBackground(true);

    int id=metaPriorityRequest; metaPriorityRequest=-1;
    if(id<0 && millis()-priorityAt>12000UL){id=nativeStation;priorityAt=millis();}
    if(net && id>=0 && id<STATION_COUNT && normalOk){
      String track,program,source;
      if(id==11){program=fetchViaProgram();source="oficjalna strona Radio VIA";}
      else{
        track=fetchMyRadioOnline(id,myRadioSlug(id));
        if(heavyOk) program=fetchMyRadioProgram(id,myRadioSlug(id));
        source="MyRadioOnline - priorytet";
      }
      if(track.length()){
        internetInfo[id]=track;
        // Dokladny wynik ma pierwszenstwo. Zmiana tytulu natychmiast uniewaznia stara okladke.
        bool changed = songNow[id] != track;
        songNow[id]=track; preciseMetaAt[id]=millis();
        if(changed){
          songChangedAt[id]=millis();
          if(id==nativeStation){
            pendingArtworkTitle=cleanSongForArtwork(track); pendingArtworkUrl=""; pendingArtworkSince=millis(); artworkState=ART_SEARCH; artworkAttempts=0;
            titleScrollOffset=0; lastScrollSong=""; imageScreenDirty=true;
          }
        }
      }
      if(program.length())splitProgramData(id,program);
      if(metaMutex&&xSemaphoreTake(metaMutex,pdMS_TO_TICKS(100))==pdTRUE){
        String combined=track.length()?track:program;
        if(combined.length())metaCache[id]=combined;
        metaCacheSource[id]=source;metaCacheAt[id]=millis();xSemaphoreGive(metaMutex);
      }
      if(id==nativeStation && track.length())ensureArtwork(id,track);
    }

    if(net && normalOk && millis()-listAt>=15000UL){
      String titles[11];uint32_t bytes=0;
      if(fetchMyRadioList(titles,bytes)){
        if(metaMutex&&xSemaphoreTake(metaMutex,pdMS_TO_TICKS(120))==pdTRUE){
          for(uint8_t i=0;i<11;i++)if(titles[i].length()){
            // Nie nadpisuj nowszej informacji dokładnej starszym wynikiem zbiorczym.
            if(!preciseMetaAt[i] || millis()-preciseMetaAt[i]>30000UL){
              metaCache[i]=titles[i];metaCacheSource[i]="MyRadioOnline - lista 15 s";metaCacheAt[i]=millis();
              bool changed = songNow[i] != titles[i]; songNow[i]=titles[i];
              if(changed){
                songChangedAt[i]=millis();
                if(i==nativeStation){pendingArtworkTitle=cleanSongForArtwork(titles[i]);pendingArtworkSince=millis();imageScreenDirty=true;}
              }
            }
          }
          xSemaphoreGive(metaMutex);
        }
      }
      listAt=millis();
    }

    int sid=schedulePriorityRequest;schedulePriorityRequest=-1;
    if(sid<0 && heavyOk && millis()-scheduleAt>12000UL)sid=scheduleCursor++%STATION_COUNT;
    if(net&&heavyOk&&sid>=0&&sid<STATION_COUNT){
      if(sid<11){String p=fetchMyRadioProgram(sid,myRadioSlug(sid));if(p.length())splitProgramData(sid,p);}
      else if(metaMutex&&xSemaphoreTake(metaMutex,pdMS_TO_TICKS(80))==pdTRUE){
        scheduleCache[11].checked=true;scheduleCache[11].count=0;scheduleCache[11].updated=millis();xSemaphoreGive(metaMutex);
      }
      scheduleAt=millis();
      if(screenPage==PAGE_SCHEDULE&&sid==scheduleStation)imageScreenDirty=true;
    }

    if(net&&heavyOk&&logoCursor<STATION_COUNT)ensureStationLogo(logoCursor++);
    // Jesli aktualny utwor nie ma pasujacej okladki, kolejka sama sie odbuduje.
    String wantedArt=cleanSongForArtwork(songNow[nativeStation]);
    if(wantedArt.length() && cachedArtTitle[nativeStation]!=wantedArt && pendingArtworkTitle!=wantedArt){
      pendingArtworkTitle=wantedArt;pendingArtworkUrl="";pendingArtworkSince=millis();artworkState=ART_SEARCH;artworkAttempts=0;imageScreenDirty=true;
    }
    if(net&&heavyOk&&pendingArtworkTitle.length())ensureArtwork(nativeStation,pendingArtworkTitle);
    vTaskDelay(pdMS_TO_TICKS(bufferRisk==BUFFER_CRITICAL?500:180));
  }
}

void startLocalMetaTask(){
  if(localMetaTaskHandle || appMode!=APP_RADIO || !nativePlaying)return;
  localMetaTaskStop=false;
  if(xTaskCreatePinnedToCore(localMetaTask,"radio-meta",9216,nullptr,1,&localMetaTaskHandle,0)!=pdPASS){
    localMetaTaskHandle=nullptr;
    nativeInfo="Brak RAM dla RDS/okladek";
  }
}

void stopLocalMetaTask(){
  localMetaTaskStop=true;
  metaPriorityRequest=-1;
  schedulePriorityRequest=-1;
}

// Zdarzenia biblioteki ESP32-audioI2S.
void audio_info(const char* info) {
  nativeInfo = info ? info : "";
  String s = nativeInfo; s.toLowerCase();
  if (s.indexOf("connected") >= 0 || s.indexOf("stream ready") >= 0 || s.indexOf("codec") >= 0 || s.indexOf("buffer") >= 0) {
    nativeAudioProgress = true; nativeProgressAt = millis();
  }
  if (s.indexOf("stream ready") >= 0 || s.indexOf("audio codec") >= 0 || s.indexOf("playing") >= 0) {
    nativeConnecting = false; nativePlaying = true; nativePlayAt = millis(); autoRecoverPending=false; autoRecoverAttempts=0; zeroBufferSince=0; setRgb(LED_PLAY);
    stationHealth[nativeStation]=1; stationResponseMs[nativeStation]=min(65535UL,millis()-nativeConnectAt); sourceSavePending=true;
  }
  // Nie traktuj kazdego przejsciowego error/timeout jako smierci strumienia.
  // O zmianie zrodla decyduja glownie timeouty 5/12 s w loop() i watchdog bufora.
  if (s.indexOf("not found") >= 0 || s.indexOf("connection refused") >= 0 || s.indexOf("invalid url") >= 0) nativeSwitchRequested = true;
}
void audio_showstation(const char* info) { if (info && *info) { nativeAudioProgress = true; nativeProgressAt = millis(); } }
void audio_showstreamtitle(const char* info) {
  if (info && *info) {
    nativeStreamTitle = info; streamInfo[nativeStation] = info;
    String fresh=String(info); fresh.trim();
    if(fresh.length() && fresh!=songNow[nativeStation]){
      songNow[nativeStation]=fresh; preciseMetaAt[nativeStation]=millis(); songChangedAt[nativeStation]=millis();
      pendingArtworkTitle=cleanSongForArtwork(fresh); pendingArtworkUrl=""; pendingArtworkSince=millis(); artworkState=ART_SEARCH; artworkAttempts=0;
      titleScrollOffset=0; lastScrollSong=""; imageScreenDirty=true;
    } else if(fresh.length()) preciseMetaAt[nativeStation]=millis();
  }
  nativeAudioProgress=true;nativeProgressAt=millis();nativeConnecting=false;nativePlaying=true;autoRecoverPending=false;autoRecoverAttempts=0;zeroBufferSince=0;setRgb(LED_PLAY);
  stationHealth[nativeStation]=1;stationResponseMs[nativeStation]=min(65535UL,millis()-nativeConnectAt);sourceSavePending=true;
}
void audio_bitrate(const char* info) { nativeBitrate = info ? info : ""; nativeAudioProgress = true; nativeProgressAt = millis(); }
