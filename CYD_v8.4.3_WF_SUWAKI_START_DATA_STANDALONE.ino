  if (id < 11) source = "https://myradioonline.pl/public/uploads/radio_img/" + String(slugs[id]) + "/play_250_250.webp";
  else source = "https://radiovia.com.pl/wp-content/uploads/2018/02/Radio-Via-logo-KRRz.jpg";
  // Serwer obrazu zwraca mały JPEG 88x88, który LovyanGFX może wyświetlić bez dodatkowej biblioteki WebP.
