bool connectKnownWifi(const String& ssid, const String& pass, uint32_t timeoutMs, const char* label) {
  if (!ssid.length() || ssid.startsWith("NAZWA_") || pass.startsWith("WPISZ_TUTAJ_")) return false;
  WiFi.disconnect(); delay(150); WiFi.mode(WIFI_STA);
  Serial.print("Proba Wi-Fi "); Serial.print(label); Serial.print(": "); Serial.println(ssid);
  WiFi.begin(ssid.c_str(), pass.c_str());
  uint32_t started = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - started < timeoutMs) {
    delay(200); Serial.print('.'); setRgb(LED_BUFFER);
    tft.fillRect(45, 202, 390, 24, UI_M0NKA_BG);
    tft.setTextDatum(middle_center); tft.setTextColor(0xFD20);
    tft.drawString(String(label) + ": " + String((millis() - started) / 1000) + " / " + String(timeoutMs / 1000) + " s", 240, 214);
  }
  Serial.println();
  return WiFi.status() == WL_CONNECTED;
}

