String urlEncodeNative(const String& value) {
  const char hex[] = "0123456789ABCDEF";
  String out; out.reserve(value.length() * 2);
  for (size_t i = 0; i < value.length(); ++i) {
    uint8_t c = (uint8_t)value[i];
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
        (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') out += (char)c;
    else { out += '%'; out += hex[c >> 4]; out += hex[c & 15]; }
  }
  return out;
}

bool downloadJpegToFlash(const String& url, const String& path, size_t maxBytes = 90000) {
  if (!imageStorageReady || WiFi.status()!=WL_CONNECTED || !url.length()) return false;
  artworkDownloadActive=true;
  WiFiClientSecure tls; tls.setInsecure(); tls.setTimeout(5);
  HTTPClient http;
  if(!http.begin(tls,url)){artworkDownloadActive=false;return false;}
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS); http.setTimeout(2500);
  int code=http.GET(); int total=http.getSize();
  if(code!=HTTP_CODE_OK || total>(int)maxBytes){http.end();artworkDownloadActive=false;return false;}
  String temp=path+".tmp"; SPIFFS.remove(temp);
  File file=SPIFFS.open(temp,FILE_WRITE);
  if(!file){http.end();artworkDownloadActive=false;return false;}
  WiFiClient* stream=http.getStreamPtr();
  uint8_t chunk[384]; size_t written=0; uint32_t lastData=millis();
  bool aborted=false;
  while(http.connected() && written<maxBytes && (total<0 || written<(size_t)total)){
    if(nativePlaying && (bufferRisk==BUFFER_CRITICAL || bufferPercent()<28)){aborted=true;break;}
    size_t available=stream->available();
    if(!available){if(millis()-lastData>1000){aborted=true;break;}vTaskDelay(pdMS_TO_TICKS(3));continue;}
    size_t count=min(available,sizeof(chunk));
    int got=stream->readBytes(chunk,count);
    if(got<=0){aborted=true;break;}
    if(written+got>maxBytes || file.write(chunk,got)!=(size_t)got){aborted=true;break;}
    written+=got;lastData=millis();
    vTaskDelay(pdMS_TO_TICKS(2));
  }
  file.close();http.end();artworkDownloadActive=false;
  File check=SPIFFS.open(temp,FILE_READ);
  bool jpeg=!aborted && check && check.size()>700 && check.read()==0xFF && check.read()==0xD8;
  if(check)check.close();
  if(!jpeg){SPIFFS.remove(temp);return false;}
  SPIFFS.remove(path);
  if(!SPIFFS.rename(temp,path)){SPIFFS.remove(temp);return false;}
  return true;
}

String stationLogoDownloadUrl(uint8_t id) {
