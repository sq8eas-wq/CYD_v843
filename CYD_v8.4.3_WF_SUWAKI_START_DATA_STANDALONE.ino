  pinMode(BATTERY_ADC_PIN, INPUT);
  prefs.begin("cyd-radio", false); rotation180=prefs.getBool("rot180",DEFAULT_ROTATE_180);
  lightTheme=prefs.getBool("lightui",false);applyUiTheme();
  m0TuneStep=prefs.getUShort("m0step",500); if(m0TuneStep!=100&&m0TuneStep!=500&&m0TuneStep!=1000&&m0TuneStep!=5000)m0TuneStep=500;
  m0InputDiq=true; m0RemoteHost=prefs.getString("m0remote",""); m0AudioVolume=prefs.getUChar("m0vol",70); if(m0AudioVolume>100)m0AudioVolume=70;
  m0AudioBoost=prefs.getBool("m0boost",false);
  m0SmCalDb=prefs.getChar("m0smcal",0); if(m0SmCalDb<-30||m0SmCalDb>30)m0SmCalDb=0;
  m0WfContrast=prefs.getUChar("m0contr",70); if(m0WfContrast<40||m0WfContrast>80)m0WfContrast=70;
  m0WfPoints=prefs.getUShort("m0wfpts",232);if(m0WfPoints<116||m0WfPoints>464)m0WfPoints=232;
  m0WfFps=prefs.getUChar("m0wffps",10);if(m0WfFps<5||m0WfFps>20)m0WfFps=10;
  prefetchAtBoot=prefs.getBool("bootdata",false);
  m0CwTone=prefs.getUShort("m0cwtone",700); if(m0CwTone<400||m0CwTone>1000)m0CwTone=700;
  m0CwSensitivity=prefs.getUChar("m0cwsens",55); if(m0CwSensitivity<20||m0CwSensitivity>90)m0CwSensitivity=55;
  homeM0IconStyle=1; // v7.0: stabilna ikona wektorowa; raster v6.9 byl uszkodzony na ekranie
  batteryMonitorEnabled=true; // v7.6: automatyczne wykrywanie, bez mylacego ON/OFF
  { String pp=prefs.getString("m0prof",""); if(pp.length())m0Profile=pp; int8_t dd=prefs.getChar("m0iqdir",0); if(dd==1||dd==-1)m0IqDirection=dd; }
  tft.init(); tft.setRotation(rotation180 ? 3 : 1); tft.setBrightness(displayBrightness);
  tft.fillScreen(UI_M0NKA_BG); tft.setTextDatum(middle_center); tft.setTextColor(TFT_WHITE); tft.setTextSize(2);
  tft.drawString("CYD RADIO 3.5", 240, 105); tft.setTextSize(1); tft.setTextColor(0x2FFF);
  tft.drawString("ESP32-3248S035R + SPEAKER1", 240, 142);
  tft.drawString("Uruchamianie...", 240, 178);

  // v3.1j: awaryjne wymuszenie kalibracji dotyku przyciskiem BOOT (GPIO0).
  // Uruchom CYD normalnie. Po pojawieniu sie ekranu startowego nacisnij BOOT
  // w ciagu ok. 2 s i trzymaj 4 s. Nie trzymaj BOOT podczas resetu/zasilania.
  pinMode(0, INPUT_PULLUP);
  bool forceTouchCalibration = false;
  uint32_t bootWindowStart = millis();
  uint32_t bootHeldFrom = 0;
  while (millis() - bootWindowStart < 2200UL && !forceTouchCalibration) {
    if (digitalRead(0) == LOW) {
      if (bootHeldFrom == 0) {
        bootHeldFrom = millis();
        tft.fillRect(55, 190, 370, 42, UI_M0NKA_BG);
        tft.setTextDatum(middle_center); tft.setTextColor(TFT_YELLOW); tft.setTextSize(1);
        tft.drawString("BOOT: trzymaj 4 s - kalibracja dotyku", 240, 210);
        Serial.println(F("BOOT: wykryto nacisniecie, trzymaj 4 s aby wymusic kalibracje."));
      }
      while (digitalRead(0) == LOW && !forceTouchCalibration) {
        if (millis() - bootHeldFrom >= 4000UL) { forceTouchCalibration = true; break; }
        delay(20);
      }
      if (!forceTouchCalibration) bootHeldFrom = 0;
    }
    delay(20);
  }

  for (uint8_t i = 0; i < STATION_COUNT; ++i) cachedArtTitle[i] = prefs.getString(("art" + String(i)).c_str(), "");
  const char* touchKey = rotation180 ? "touch3r" : "touch3n";
  if (forceTouchCalibration) {
    prefs.remove("touch3n");
    prefs.remove("touch3r");
    Serial.println(F("BOOT 4 s: usunieto zapisana kalibracje dotyku."));
  }
  uint16_t touchCal[8];
  if (prefs.getBytesLength(touchKey) == sizeof(touchCal)) {
    prefs.getBytes(touchKey, touchCal, sizeof(touchCal)); tft.setTouchCalibrate(touchCal);
  } else {
    tft.fillScreen(TFT_BLACK); tft.setTextColor(TFT_WHITE); tft.setTextDatum(top_center);
    tft.drawString("Kalibracja dotyku - dotykaj wskazane punkty rysikiem", 240, 8);
    tft.calibrateTouch(touchCal, TFT_MAGENTA, TFT_BLACK, 15); prefs.putBytes(touchKey, touchCal, sizeof(touchCal));
  }
  weatherCity=prefs.getUChar("wcity",0);if(weatherCity>2)weatherCity=0; m0TuneStep=prefs.getUShort("m0step",500);if(m0TuneStep!=100&&m0TuneStep!=500&&m0TuneStep!=1000&&m0TuneStep!=5000)m0TuneStep=500; m0AudioVolume=prefs.getUChar("m0vol",70);if(m0AudioVolume>100)m0AudioVolume=70;
  nativeVolume = prefs.getUChar("volume", 35); if (nativeVolume > 100) nativeVolume = 35;
  nativeFast = prefs.getBool("fast", true); nativeAutoQuality = prefs.getBool("autoq", true);
  autoBrightness = prefs.getBool("autobri", true); manualBrightnessPct=prefs.getUChar("bripct",75); if(manualBrightnessPct!=25&&manualBrightnessPct!=50&&manualBrightnessPct!=75&&manualBrightnessPct!=100)manualBrightnessPct=75; if(!autoBrightness){displayBrightness=brightnessPctToValue(manualBrightnessPct);tft.setBrightness(displayBrightness);} nativeCarMode = prefs.getBool("car", false);
  nativeStation = prefs.getChar("station", 0); if (nativeStation < 0 || nativeStation >= STATION_COUNT) nativeStation = 0;
  // v7.9 BOOT SAFE: podczas startu nie uruchamiamy Radia, I2S, DAC ani testu
  // glosnika. Test pozostaje dostepny recznie w MENU M0NKA.

  configTzTime("CET-1CEST,M3.5.0/2,M10.5.0/3", "pool.ntp.org", "time.nist.gov");
  EEPROM.begin(sizeof(SavedWifi)); SavedWifi saved = {}; EEPROM.get(0, saved);
  String ssid = (saved.magic == WIFI_MAGIC && strlen(saved.ssid)) ? String(saved.ssid) : String(WIFI_SSID);
  String pass = (saved.magic == WIFI_MAGIC) ? String(saved.pass) : String(WIFI_PASSWORD);
  WiFi.persistent(false); WiFi.mode(WIFI_STA); WiFi.setHostname("cyd-radio");
  WiFi.setSleep(false);
  bool connected = connectKnownWifi(ssid, pass, WIFI_HOME_TIMEOUT_MS, "Domowe Wi-Fi");
  if (!connected) connected = connectKnownWifi(PHONE_WIFI_SSID, PHONE_WIFI_PASSWORD, WIFI_PHONE_TIMEOUT_MS, "Galaxy A13");
  if (WiFi.status() == WL_CONNECTED) { MDNS.begin("radio"); }
  else {
    Serial.println(F("Brak obu znanych sieci - uruchamiam CYD-Radio"));
    WiFi.disconnect(); WiFi.mode(WIFI_AP); WiFi.softAP(AP_SSID, AP_PASSWORD);
  }
  startWeb(); metaMutex = xSemaphoreCreateMutex();
  // v8.2: zadanie RDS/okladek powstaje dopiero po uruchomieniu Radia.
  printAddressAfterStartup();
  startupPrefetchData();
  chooseStartupApp();
  if(WiFi.status()!=WL_CONNECTED)setRgb(LED_ERROR);
}

void loop() {
  if(appMode==APP_HOME){
    if(audio)audio->loop();server.handleClient();updateBrightness();updateBatteryMonitor();handleHomeTouch();
    uint32_t now=millis();
    if(weatherTaskReady){weatherTaskReady=false;drawMainMenu();}
    // v8.1: HOME nie uruchamia ciezkich zapytan automatycznie. Pogoda pobiera
    // sie po wejsciu do POGODA, a test serwera po dotknieciu jego przycisku.
    // Dzieki temu PLAY zawsze dostaje pierwszenstwo i duzy ciagly blok RAM.
    static uint32_t homeAt=0;if(now-homeAt>1000UL){homeAt=now;updateHomeClock();}
    static uint32_t homeStatusAt=0;
    if(m0ProbeReady||now-homeStatusAt>2200UL){m0ProbeReady=false;homeStatusAt=now;updateHomeStatusFields();}
    return;
  }
  if(appMode==APP_WEATHER){weatherLoop();return;}
  if(appMode==APP_M0NKA){server.handleClient();updateBrightness();m0Loop();return;}
  // Najwyższy priorytet: dekoder audio.
  if(audio)audio->loop();
  server.handleClient();
  handleTouch();
  updateBrightness();

  // v3.1e: pewny autostart + samoczynne odzyskiwanie streamu.
  if (autoPlayPending && WiFi.status() == WL_CONNECTED && (int32_t)(millis() - autoPlayDueAt) >= 0) {
    if(!radioResourcesReady()){
      autoPlayDueAt=millis()+350;
      nativeInfo="Czekam na zwolnienie pamieci i sieci";
    }else{
      autoPlayPending = false;
      autoPlayAttempted = true;
      autoPlayAttemptAt = millis();
      Serial.print(F("Autostart: uruchamiam ")); Serial.println(stations[nativeStation].name);
      playNativeStation(nativeStation);
    }
  }
  // Jeśli pierwsza próba po starcie zakończy się całkowitym niepowodzeniem,
  // spróbuj ponownie maksymalnie 2 razy. Ręczne STOP/PAUZA później tego nie uruchamia.
  if (autoPlayAttempted && !nativePlaying && !nativeConnecting && WiFi.status() == WL_CONNECTED &&
      autoPlayRetries < 2 && millis() - autoPlayAttemptAt > 8000UL) {
    autoPlayRetries++;
    autoPlayAttemptAt = millis();
    Serial.print(F("Autostart: ponowna proba ")); Serial.println(autoPlayRetries);
    playNativeStation(nativeStation);
  }
  if (nativePlaying) autoPlayAttempted = false;
  if(nativePlaying && millis()-nativePlayAt>5000UL)startLocalMetaTask();

  // Samoczynne odzyskanie po awarii wszystkich zrodel. Nie dziala po recznej PAUZIE.
  if(autoRecoverPending && !nativeUserStopped && WiFi.status()==WL_CONNECTED &&
     !nativePlaying && !nativeConnecting && (int32_t)(millis()-autoRecoverDueAt)>=0){
    autoRecoverPending=false;
    Serial.print(F("AutoRecovery: restart stacji ")); Serial.println(stations[nativeStation].name);
    playNativeStation(nativeStation);
  }

  if(imageScreenDirty && bufferRisk!=BUFFER_CRITICAL){
    imageScreenDirty=false;
    if(screenPage==PAGE_PLAYER)drawNativeImages();
    else if(screenPage==PAGE_SCHEDULE)drawSchedule();
  }
  if(nativeSwitchRequested)switchNativeSource("Blad strumienia - nastepne zrodlo");
  if(nativeConnecting){
    uint32_t elapsed=millis()-nativeConnectAt;
    if(!nativeAudioProgress&&elapsed>5000)switchNativeSource("Brak odpowiedzi przez 5 s");
    else if(nativeAudioProgress&&!nativePlaying&&elapsed>12000)switchNativeSource("Bufor nie wystartowal przez 12 s");
  }
  if(WiFi.status()==WL_CONNECTED&&nativeStation==11&&millis()-uiLastMeta>15000UL&&bufferAllowsBackground(false)){
    metaPriorityRequest=11;uiLastMeta=millis();
  }
  if(sleepUntilMs&&(int32_t)(millis()-sleepUntilMs)>=0){sleepUntilMs=0;stopNative();}

  static uint32_t statAt=0;
  if((nativePlaying||nativeConnecting)&&millis()-statAt>250){
    statAt=millis();
    if(!audio)return;
    audioBufferSize=audio->inBufferSize();audioBufferFilled=audio->inBufferFilled();
    actualBitrate=audio->getBitRate();actualSampleRate=audio->getSampleRate();actualChannels=audio->getChannels();actualCodec=audio->getCodecname();
    if(audioBufferFilled<bufferMinBytes)bufferMinBytes=audioBufferFilled;
    uint8_t pct=bufferPercent();
    float delta=(float)pct-(float)lastBufferPct;bufferTrendPct=bufferTrendPct*0.75f+delta*0.25f;lastBufferPct=pct;
    if(pct>bufferPeakPct)bufferPeakPct=pct;
    if(!bufferLearnStarted)bufferLearnStarted=millis();
    if(millis()-bufferLearnStarted<20000UL){
      if(bufferTypicalPct==0)bufferTypicalPct=pct;else bufferTypicalPct=bufferTypicalPct*0.92f+pct*0.08f;
      bufferRisk=BUFFER_LEARNING;
    }else{
      bufferTypicalPct=bufferTypicalPct*0.97f+pct*0.03f;
      float sec=bufferSeconds();
      (void)sec; // sekundy pozostaja informacja diagnostyczna, nie glownym progiem ryzyka
      float typical = max(20.0f, bufferTypicalPct);
      bool critical = (pct < 10) || (pct < typical * 0.28f) ||
                      (pct < 45 && bufferTrendPct < -8.0f);
      bool caution  = (pct < 35) || (pct < typical * 0.60f) ||
                      (pct < 70 && bufferTrendPct < -4.0f);
      if(critical)bufferRisk=BUFFER_CRITICAL;
      else if(caution)bufferRisk=BUFFER_CAUTION;
      else bufferRisk=BUFFER_SAFE;
    }
    bool low=bufferRisk==BUFFER_CRITICAL;
    if(low&&!bufferWasLow){bufferUnderruns++;lastUnderrunAt=millis();bufferStableSince=0;}
    bufferWasLow=low;
    if(bufferRisk==BUFFER_SAFE){if(!bufferStableSince)bufferStableSince=millis();}
    else bufferStableSince=0;

    // Watchdog zaciecia: jezeli podczas grania bufor praktycznie znika na kilka sekund,
    // przejdz do kolejnego zrodla zamiast czekac na klikniecie PLAY.
    if(nativePlaying && pct<=3){
      if(!zeroBufferSince)zeroBufferSince=millis();
      else if(millis()-zeroBufferSince>3500UL){
        zeroBufferSince=0; nativeSwitchRequested=true; nativeInfo="Pusty bufor - automatyczne odzyskiwanie";
        Serial.println(F("AudioWatchdog: pusty bufor >3.5 s, zmieniam zrodlo"));
      }
    } else zeroBufferSince=0;
  }else if(!nativePlaying){
    bufferRisk=BUFFER_SAFE;bufferStableSince=millis();
  }

  // Zapis flash dopiero po uspokojeniu audio lub na pauzie.
  bool safeWrite=!nativePlaying||bufferAllowsBackground(true);
  if(volumeSavePending&&millis()-volumeSaveAt>2500UL&&safeWrite){prefs.putUChar("volume",nativeVolume);volumeSavePending=false;}
  if(sourceSavePending&&nativePlaying&&millis()-nativePlayAt>3000UL&&safeWrite){
    String k="src"+String(nativeStation);prefs.putUChar(k.c_str(),nativeSource);sourceSavePending=false;
  }

  uint32_t uiPeriod=bufferRisk==BUFFER_CRITICAL?2500UL:bufferRisk==BUFFER_CAUTION?1400UL:700UL;
  if(millis()-uiLastDraw>uiPeriod){updatePlayerInfo();if(screenPage==PAGE_DIAG&&bufferRisk!=BUFFER_CRITICAL)drawDiag();uiLastDraw=millis();}
  static uint32_t tileAt=0;
  if(screenPage==PAGE_STATIONS&&bufferRisk!=BUFFER_CRITICAL&&millis()-tileAt>15000UL){tileAt=millis();updateStationTiles();}
  delay(1);
}
