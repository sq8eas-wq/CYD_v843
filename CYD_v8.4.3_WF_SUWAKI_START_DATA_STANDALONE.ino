String cleanSongForArtwork(String title) {
  int marker = title.indexOf("| Utwor:");
  if (marker >= 0) title = title.substring(marker + 8);
  title.trim();
  int firstDash = title.indexOf(" - ");
  if (firstDash > 0 && firstDash <= 6) {
    bool looksLikeTime = title.indexOf(':') >= 0;
    if (looksLikeTime) { title = title.substring(firstDash + 3); title.trim(); }
  }
  if (title.indexOf(" - ") < 0 || title.length() < 5) return "";
  return title;
}

String findArtworkUrl(const String& title) {
  String song = cleanSongForArtwork(title); if (!song.length()) return "";
  WiFiClientSecure tls; tls.setInsecure(); tls.setTimeout(2);
  HTTPClient http;
  String url = "https://itunes.apple.com/search?entity=song&limit=1&term=" + urlEncodeNative(song);
  if (!http.begin(tls, url)) return "";
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS); http.setTimeout(1800);
  int code = http.GET(); String body;
  if (code == HTTP_CODE_OK) { body = http.getString(); if (body.length() > 12000) body = ""; }
  http.end();
  return jsonField(body, "artworkUrl100");
}

