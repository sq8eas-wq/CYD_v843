int wifiQualityPct(){if(WiFi.status()!=WL_CONNECTED)return 0;int r=WiFi.RSSI();return constrain(2*(r+100),0,100);}
uint8_t batteryPctFromVoltage(float v){
  const float vv[]={3.30,3.45,3.60,3.70,3.80,3.90,4.00,4.10,4.20};const uint8_t pp[]={0,5,15,30,50,65,80,90,100};
  if(v<=vv[0])return 0;if(v>=vv[8])return 100;for(int i=1;i<9;i++)if(v<=vv[i])return pp[i-1]+(uint8_t)((v-vv[i-1])/(vv[i]-vv[i-1])*(pp[i]-pp[i-1]));return 0;
}
void updateBatteryMonitor(){
  if(!batteryMonitorEnabled){batteryDetected=false;return;}if(millis()-batteryLastAt<1800)return;batteryLastAt=millis();
  uint32_t sum=0,mn=UINT32_MAX,mx=0;for(int i=0;i<8;i++){uint32_t mv=analogReadMilliVolts(BATTERY_ADC_PIN);sum+=mv;mn=min(mn,mv);mx=max(mx,mv);delayMicroseconds(180);}
  float v=(sum/8.0f)*2.0f/1000.0f;
  // Nieuzbrojone wejscie ADC jest niestabilne. Wymagamy prawidlowego zakresu
  // i malego rozrzutu, aby nie pokazywac przypadkowej "baterii".
  if(v>=3.0f&&v<=4.45f&&(mx-mn)<45){batteryDetected=true;batteryVoltage=batteryVoltage?batteryVoltage*.75f+v*.25f:v;batteryPercent=batteryPctFromVoltage(batteryVoltage);}else batteryDetected=false;
}
