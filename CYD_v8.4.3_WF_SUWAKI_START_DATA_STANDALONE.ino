void handleHomeTouch(){
  uint16_t x,y;if(!tft.getTouch(&x,&y)||millis()-uiLastTouch<220)return;uiLastTouch=millis();
  if(batteryPopupOpen){batteryPopupOpen=false;drawMainMenu();return;}
  if(networkDiagOpen){if((x>=365&&y>=60&&y<=105)||y>286){networkDiagOpen=false;drawMainMenu();}return;}
  if(homeSettingsOpen){
    if(y<45&&x>390){homeSettingsOpen=false;drawMainMenu();return;}
    if(y>=48&&y<=102){wifiConfigScreen();return;}
    if(y>=104&&y<=164&&x<240){
      if(autoBrightness)applyManualBrightness(25);else if(manualBrightnessPct==25)applyManualBrightness(50);else if(manualBrightnessPct==50)applyManualBrightness(75);else if(manualBrightnessPct==75)applyManualBrightness(100);else{autoBrightness=true;prefs.putBool("autobri",true);}drawHomeSettings();return;
    }
    if(y>=104&&y<=164&&x>=240){lightTheme=!lightTheme;prefs.putBool("lightui",lightTheme);applyUiTheme();drawHomeSettings();return;}
    if(y>=166&&y<=226&&x<240){networkDiagOpen=true;homeSettingsOpen=false;drawMainMenu();return;}
    if(y>=166&&y<=226&&x>=240){startM0Probe();drawHomeSettings();return;}
    if(y>=228&&y<=286){prefetchAtBoot=!prefetchAtBoot;prefs.putBool("bootdata",prefetchAtBoot);startupLoadModeChanged=true;drawHomeSettings();return;}
    return;
  }
  if(x>=432&&y<=58){batteryPopupOpen=true;drawMainMenu();return;}
  if(x>=382&&x<432&&y<=58){networkDiagOpen=true;if(!m0ProbeBusy)startM0Probe();drawMainMenu();return;}
  if(x<=58&&y>=286){homeSettingsOpen=true;drawHomeSettings();return;}
  if(y>=73&&y<=269){
    if(x>=24&&x<160){enterRadioFromHome();return;}
    if(x>=172&&x<308){enterM0nkaFromHome();return;}
    if(x>=320&&x<456){enterWeatherFromHome();return;}
  }
}

