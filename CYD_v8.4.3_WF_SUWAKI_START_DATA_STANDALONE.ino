ParsedUrl parseUrl(const String& url) {
  ParsedUrl p = {false, "", 0, "/", false};
  int pos;
  if (url.startsWith("https://")) { p.tls = true; pos = 8; p.port = 443; }
  else if (url.startsWith("http://")) { pos = 7; p.port = 80; }
  else return p;
  int slash = url.indexOf('/', pos); String authority = slash < 0 ? url.substring(pos) : url.substring(pos, slash);
  p.path = slash < 0 ? "/" : url.substring(slash);
  int colon = authority.lastIndexOf(':');
  if (colon > 0) { p.host = authority.substring(0, colon); p.port = authority.substring(colon + 1).toInt(); }
  else p.host = authority;
  p.ok = p.host.length() > 0; return p;
}

String extractTitle(String meta) {
  int a = meta.indexOf("StreamTitle='");
  if (a < 0) a = meta.indexOf("StreamTitle=\"");
  if (a < 0) return "";
  a += 13; char quote = meta.charAt(a - 1); int b = meta.indexOf(quote, a);
  if (b < 0) b = meta.indexOf(';', a);
  String t = b > a ? meta.substring(a, b) : ""; t.trim(); return t;
}

String readIcy(Client& c, const ParsedUrl& p) {
  c.print(String("GET ") + p.path + " HTTP/1.1\r\nHost: " + p.host + "\r\nUser-Agent: CYDRadio/9\r\nIcy-MetaData: 1\r\nConnection: close\r\n\r\n");
  uint32_t deadline = millis() + 6000; String line; int metaInt = -1;
  while ((int32_t)(deadline - millis()) > 0) {
    if (!c.connected() && !c.available()) return "";
    if (!c.available()) { delay(1); yield(); continue; }
    line = c.readStringUntil('\n'); line.trim();
    if (line.length() == 0) break;
    if (line.substring(0, 12).equalsIgnoreCase("icy-metaint:")) metaInt = line.substring(12).toInt();
  }
  if (metaInt <= 0 || metaInt > 1000000) return "";
  // Niektóre serwery wysyłają pierwszy blok metadanych pusty.
  // Sprawdzamy do czterech kolejnych bloków zamiast od razu rezygnować.
  for (uint8_t block = 0; block < 4 && (int32_t)(deadline - millis()) > 0; block++) {
    int remaining = metaInt;
    while (remaining > 0 && (int32_t)(deadline - millis()) > 0) {
      int n = c.available(); if (n <= 0) { delay(1); yield(); continue; }
      while (n-- > 0 && remaining > 0) { c.read(); remaining--; }
      yield();
    }
    while (!c.available() && (int32_t)(deadline - millis()) > 0) { delay(1); yield(); }
    if (!c.available()) return "";
    int len = c.read() * 16; if (len < 0 || len > 4080) return "";
    if (len == 0) continue;
    String meta; meta.reserve(len);
    while (len-- > 0 && (int32_t)(deadline - millis()) > 0) {
      if (c.available()) { char ch = c.read(); if (ch) meta += ch; }
      else { delay(1); yield(); }
    }
    String title = extractTitle(meta);
    if (title.length()) return title;
  }
  return "";
}

String fetchMetadata(const String& url) {
  if (WiFi.status() != WL_CONNECTED) return "";
  ParsedUrl p = parseUrl(url); if (!p.ok) return "";
  if (p.tls) {
    WiFiClientSecure client; client.setInsecure(); client.setTimeout(6);
    if (!client.connect(p.host.c_str(), p.port)) return "";
    return readIcy(client, p);
  } else {
    WiFiClient client; client.setTimeout(6);
    if (!client.connect(p.host.c_str(), p.port)) return "";
    return readIcy(client, p);
  }
}

