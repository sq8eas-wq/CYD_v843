uint8_t bufferPercent() {
  if (!audioBufferSize) return 0;
  return (uint8_t)min(100UL, audioBufferFilled * 100UL / audioBufferSize);
}

float bufferSeconds() {
  uint32_t rate = actualBitrate;
  if (!rate && nativeBitrate.length()) {
    String digits;
    for (size_t i=0;i<nativeBitrate.length();i++) if (isDigit(nativeBitrate[i])) digits += nativeBitrate[i];
    if (digits.length()) rate = digits.toInt() * 1000UL;
  }
  if (!rate) return -1.0f;
  return (audioBufferFilled * 8.0f) / (float)rate;
}

bool bufferAllowsBackground(bool heavy = false) {
  if (!nativePlaying) return true;

  const uint8_t pct = bufferPercent();
  const uint32_t playAge = nativePlayAt ? (millis() - nativePlayAt) : 0;

  // Podczas uczenia nie blokuj RDS przez kilkadziesiat sekund.
  // Lekkie zadania moga ruszyc po ustabilizowaniu odtwarzania.
  if (bufferRisk == BUFFER_LEARNING) {
    if (!heavy) return playAge > 2500UL && pct >= 35;
    return playAge > 7000UL && pct >= 80 && millis() - lastUnderrunAt > 8000UL;
  }

  if (bufferRisk == BUFFER_CRITICAL) return false;

  // Ciezkie zadania (obrazy/ramowka) tylko przy pelnym lub prawie pelnym
  // i stabilnym buforze. Sekundy bufora nie sa tu warunkiem, poniewaz
  // biblioteka dla niektorych stacji ma maly bufor wejsciowy (np. 0.4 s).
  if (heavy) {
    return bufferRisk == BUFFER_SAFE && pct >= 75 && bufferStableSince &&
           millis() - bufferStableSince > 3000UL && millis() - lastUnderrunAt > 8000UL;
  }

  return true; // SAFE i CAUTION: RDS ma dzialac, chyba ze stan jest krytyczny.
}

uint16_t bufferRiskColor() {
  if (bufferRisk == BUFFER_CRITICAL) return 0xF800;
  if (bufferRisk == BUFFER_CAUTION) return 0xFFE0;
  if (bufferRisk == BUFFER_SAFE) return 0x07E0;
  return 0x067F;
}

String bufferStatusText() {
  uint8_t pct = bufferPercent();
  String s = "BUFOR " + String(pct) + "%";
  float sec = bufferSeconds();
  if (sec >= 0.0f && sec < 99.0f) s += " | " + String(sec, 1) + " s";
  if (bufferRisk == BUFFER_LEARNING) s += " | pomiar";
  else if (bufferRisk == BUFFER_CRITICAL) s += " | ryzyko";
  else if (bufferRisk == BUFFER_CAUTION) s += " | uwaga";
  else s += " | stabilny";
  return s;
}

void splitProgramData(uint8_t id, const String& raw) {
  if (id >= STATION_COUNT || !raw.length()) return;
  int nextAt = raw.indexOf("| Nast");
  String active = nextAt >= 0 ? raw.substring(0, nextAt) : raw;
  String next = nextAt >= 0 ? raw.substring(nextAt + 1) : "";
  active.trim(); next.trim();
  int dash = active.indexOf(" - ");
  if (dash >= 0 && dash < 8) active = active.substring(dash + 3);
  int colon = next.indexOf(':');
  if (colon >= 0) next = next.substring(colon + 1);
  next.trim();
  if (active.length()) programNow[id] = active;
  if (next.length()) programNext[id] = next;
}

String localRds() {
  String result = songNow[nativeStation];
  if (!result.length()) result = nativeStreamTitle;
  if (!result.length()) {
    if (metaMutex && xSemaphoreTake(metaMutex, pdMS_TO_TICKS(10)) == pdTRUE) {
      result = metaCache[nativeStation];
      xSemaphoreGive(metaMutex);
    }
  }
  if (!result.length()) result = "Pobieranie informacji z internetu...";
  return result;
}

