    if(shown.length()>34)shown=shown.substring(shown.length()-34);
    tft.drawString(shown.length()?shown:"_",240,53);
    for(int r=0;r<4;r++){
      const char* row=symbols?symRows[r]:(upper?upperRows[r]:lowerRows[r]);
      int n=strlen(row); int keyW=min(42,440/max(1,n)); int total=keyW*n; int x0=(480-total)/2;
      for(int k=0;k<n;k++){String s=String(row[k]);button(x0+k*keyW,72+r*45,keyW-3,38,s,0x0A50);}
    }
    button(15,258,92,46,upper?"abc":"SHIFT",0x0A50);
    button(115,258,92,46,symbols?"ABC":"SYM",0x0A50);
    button(215,258,92,46,"USUN",0x0A50);
    button(315,258,70,46,"SP",0x0A50);
    button(393,258,72,46,"OK",0x04D2);
    while(true){
      uint16_t x,y;if(!tft.getTouch(&x,&y)){delay(8);continue;}delay(180);
      if(y<34&&x>385)return String("");
      if(y>=258){
        if(x<110){upper=!upper;symbols=false;break;}
        if(x<210){symbols=!symbols;break;}
        if(x<310){if(value.length())value.remove(value.length()-1);break;}
        if(x<390){if(value.length()<64)value+=' ';break;}
        return value;
      }
      if(y>=72&&y<252){
        int r=(y-72)/45;
        const char* row=symbols?symRows[r]:(upper?upperRows[r]:lowerRows[r]);
        int n=strlen(row);int keyW=min(42,440/max(1,n));int total=keyW*n;int x0=(480-total)/2;
        int k=(x-x0)/keyW;if(k>=0&&k<n&&value.length()<64)value+=row[k];
        break;
      }
    }
  }
}

