int hexValue(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

void appendUtf8(String& out, uint16_t cp) {
  if (cp < 0x80) out += (char)cp;
  else if (cp < 0x800) { out += (char)(0xC0 | (cp >> 6)); out += (char)(0x80 | (cp & 63)); }
  else { out += (char)(0xE0 | (cp >> 12)); out += (char)(0x80 | ((cp >> 6) & 63)); out += (char)(0x80 | (cp & 63)); }
}

String jsonField(const String& raw, const String& name) {
  String marker = "\"" + name + "\":\"";
  int p = raw.indexOf(marker); if (p < 0) return ""; p += marker.length();
  String out; out.reserve(150);
  for (; p < (int)raw.length() && out.length() < 240; p++) {
    char c = raw.charAt(p);
    if (c == '"') break;
    if (c != '\\') { out += c; continue; }
    if (++p >= (int)raw.length()) break;
    c = raw.charAt(p);
    if (c == 'u' && p + 4 < (int)raw.length()) {
      uint16_t cp = 0; bool ok = true;
      for (int n = 1; n <= 4; n++) { int h = hexValue(raw.charAt(p + n)); if (h < 0) ok = false; else cp = (cp << 4) | h; }
      if (ok) { appendUtf8(out, cp); p += 4; continue; }
    }
    if (c == 'n' || c == 'r' || c == 't') out += ' '; else out += c;
  }
  out.trim(); return out;
}

String jsonQuotedAt(const String& raw, int p) {
  String out; out.reserve(100);
  for (; p >= 0 && p < (int)raw.length() && out.length() < 200; p++) {
    char c = raw.charAt(p); if (c == '"') break;
    if (c != '\\') { out += c; continue; }
    if (++p >= (int)raw.length()) break; c = raw.charAt(p);
    if (c == 'u' && p + 4 < (int)raw.length()) {
      uint16_t cp = 0; bool ok = true;
      for (int n=1;n<=4;n++){int h=hexValue(raw.charAt(p+n));if(h<0)ok=false;else cp=(cp<<4)|h;}
      if(ok){appendUtf8(out,cp);p+=4;continue;}
    }
    if (c == 'n' || c == 'r' || c == 't') out += ' '; else out += c;
  }
  out.trim(); return out;
}

// Lekka ramówka. Zwraca aktualną i następną audycję (bez opisów).
String fetchMyRadioProgram(int stationId, const String& slug) {
  time_t now = time(nullptr); if (now < 1600000000 || !slug.length()) return "";
  WiFiClientSecure client; client.setInsecure(); client.setTimeout(8);
  if (!client.connect("myradioonline.pl", 443)) return "";
  String body = "date=&rid=" + String(myRadioId(stationId)) + "&type=0";
  client.print(String("POST /get-radio-program-guide HTTP/1.1\r\nHost: myradioonline.pl\r\nUser-Agent: CYDRadio/9\r\nReferer: https://myradioonline.pl/") + slug +
    "/program\r\nX-Requested-With: XMLHttpRequest\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " + String(body.length()) +
    "\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n" + body);
  String raw; raw.reserve(3200); bool headersDone=false; uint32_t deadline=millis()+10000;
  while((int32_t)(deadline-millis())>0 && raw.length()<6000){
    if(!client.available()){if(!client.connected())break;delay(1);yield();continue;}
    if(!headersDone){String line=client.readStringUntil('\n');if(line=="\r"||!line.length())headersDone=true;}
    else raw+=(char)client.read();
  }
  String active, next; long activeTs=0, nextTs=2147483647L; int p=0;
  while((p=raw.indexOf("\"program\":[\"",p))>=0){
    int titleAt=p+12; String name=jsonQuotedAt(raw,titleAt);
    int tk=raw.indexOf("\"time\":\"",p), ts=raw.indexOf("\"tstamp\":",p);
    if(tk<0||ts<0)break; String hh=jsonQuotedAt(raw,tk+8); long stamp=raw.substring(ts+9).toInt();
    String label=hh+" - "+name;
    if(stamp<=(long)now && stamp>=activeTs){activeTs=stamp;active=label;}
    if(stamp>(long)now && stamp<nextTs){nextTs=stamp;next=label;}
    p=ts+9;
  }
  String rows[7]; uint8_t rowCount=0;
  if (active.length()) rows[rowCount++]=active;
  p=0;
  while(rowCount<7 && (p=raw.indexOf("\"program\":[\"",p))>=0){
    String name=jsonQuotedAt(raw,p+12); int tk=raw.indexOf("\"time\":\"",p), ts=raw.indexOf("\"tstamp\":",p);
    if(tk<0||ts<0)break; String hh=jsonQuotedAt(raw,tk+8); long stamp=raw.substring(ts+9).toInt();
    String label=hh+" - "+name;
    if(stamp>(long)now && label!=active) rows[rowCount++]=label;
    p=ts+9;
  }
  if (stationId>=0 && stationId<STATION_COUNT && metaMutex && xSemaphoreTake(metaMutex,pdMS_TO_TICKS(200))==pdTRUE) {
    scheduleCache[stationId].count=rowCount; scheduleCache[stationId].checked=true; scheduleCache[stationId].updated=millis();
    for(uint8_t i=0;i<rowCount;i++) scheduleCache[stationId].items[i]=rows[i];
    xSemaphoreGive(metaMutex);
  }
  return active;
}

// Lekki endpoint JSON strony: zwykle poniżej 1 kB zamiast setek kB HTML.
String fetchMyRadioOnline(int stationId, const String& slug) {
  if (!slug.length() || WiFi.status() != WL_CONNECTED) return "";
  WiFiClientSecure client; client.setInsecure(); client.setTimeout(8);
  const char* host = "myradioonline.pl";
  if (!client.connect(host, 443)) return "";
  String body = "rid=" + String(myRadioId(stationId)) + "&counter=0";
  String path = "/radio/aktualis-statusz/" + slug;
  client.print(String("POST ") + path + " HTTP/1.1\r\nHost: " + host +
               "\r\nUser-Agent: CYDRadio/9\r\nReferer: https://myradioonline.pl/" + slug +
               "\r\nX-Requested-With: XMLHttpRequest\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " +
               String(body.length()) + "\r\nAccept: application/json\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n" + body);
  uint32_t deadline = millis() + 12000; bool headersDone = false; String raw; raw.reserve(1800);
  while ((int32_t)(deadline - millis()) > 0 && raw.length() < 3000) {
    if (!client.available()) { if (!client.connected()) break; delay(1); yield(); continue; }
    if (!headersDone) { String line = client.readStringUntil('\n'); if (line == "\r" || !line.length()) headersDone = true; }
    else raw += (char)client.read();
    yield();
  }
  String artist = jsonField(raw, "artist"), track = jsonField(raw, "track");
  if (artist.length() && track.length()) return artist + " - " + track;
  return artist.length() ? artist : track;
}

// Lekka zbiorcza lista "Teraz gramy". CYD pobiera tylko mały JSON,
// natomiast jego analizę, okładki i interfejs nadal obsługuje przeglądarka.
bool fetchMyRadioList(String titles[], uint32_t& sourceBytes) {
  sourceBytes = 0;
  if (WiFi.status() != WL_CONNECTED) return false;
  WiFiClientSecure client; client.setInsecure(); client.setTimeout(6);
  if (!client.connect("myradioonline.pl", 443)) return false;
  client.print(F("GET /get-radio-list-songs HTTP/1.1\r\nHost: myradioonline.pl\r\n"
                 "User-Agent: CYDRadio/9.2\r\nReferer: https://myradioonline.pl/\r\n"
                 "X-Requested-With: XMLHttpRequest\r\nAccept: application/json\r\n"
                 "Accept-Encoding: identity\r\nConnection: close\r\n\r\n"));
  bool headersDone = false, collecting = false, inString = false, escaped = false;
  int depth = 0; uint8_t found = 0; String entry; entry.reserve(420);
  uint32_t deadline = millis() + 9000;
  while ((int32_t)(deadline - millis()) > 0 && found < 11) {
    if (!client.available()) { if (!client.connected()) break; delay(1); yield(); continue; }
    if (!headersDone) {
      String line = client.readStringUntil('\n');
      if (line == "\r" || !line.length()) headersDone = true;
      continue;
    }
    char c = (char)client.read(); sourceBytes++;
    if (!collecting) {
      if (c == '"') { collecting = true; inString = true; escaped = false; depth = 0; entry = "\""; }
      continue;
    }
    entry += c;
    if (inString) {
      if (escaped) escaped = false;
      else if (c == '\\') escaped = true;
      else if (c == '"') inString = false;
    } else {
      if (c == '"') inString = true;
      else if (c == '{') depth++;
      else if (c == '}' && depth > 0) {
        depth--;
        if (depth == 0) {
          int q2 = entry.indexOf('"', 1);
          int rid = q2 > 1 ? entry.substring(1, q2).toInt() : 0;
          int idx = -1; for (uint8_t i = 0; i < 11; i++) if (myRadioId(i) == rid) { idx = i; break; }
          if (idx >= 0) {
            String title = jsonField(entry, "title"), when = jsonField(entry, "time");
            if (title.length()) { if (when.length()) title = when + " - " + title; titles[idx] = title; found++; }
          }
          collecting = false; entry = "";
        }
      }
    }
    if (entry.length() > 900) { collecting = false; entry = ""; depth = 0; }
    if ((sourceBytes & 511) == 0) yield();
  }
  return found > 0;
}

void sendListMeta() {
  // Odpowiedź natychmiast z pamięci. Sieć odpytuje osobne zadanie na rdzeniu 0,
  // dzięki czemu panel WWW nie przerywa dekodowania dźwięku.
  String out = "{\"items\":{"; bool first = true; uint8_t count = 0;
  bool locked = metaMutex && xSemaphoreTake(metaMutex, pdMS_TO_TICKS(30)) == pdTRUE;
  for (uint8_t i = 0; i < STATION_COUNT; i++) {
    if (!metaCache[i].length()) continue;
    if (!first) out += ','; first = false;
    out += "\"" + String(i) + "\":\"" + jsonEscape(metaCache[i]) + "\""; count++;
  }
  if (locked) xSemaphoreGive(metaMutex);
  out += "},\"count\":" + String(count) + ",\"background\":true,\"durationMs\":0}";
  server.sendHeader("Cache-Control", "no-store");
