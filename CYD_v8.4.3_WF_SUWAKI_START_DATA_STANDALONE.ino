void uiDrawHomeBackdrop(){
  if(lightTheme){
    tft.fillScreen(UI_BG);
    tft.fillRoundRect(18,65,142,205,20,UI_CARD);tft.drawRoundRect(18,65,142,205,20,UI_ORANGE);
    tft.fillRoundRect(169,65,142,205,20,UI_CARD);tft.drawRoundRect(169,65,142,205,20,UI_CYAN);
    tft.fillRoundRect(320,65,142,205,20,UI_CARD);tft.drawRoundRect(320,65,142,205,20,UI_WEATHER);
    drawHomeRadioIcon(89,145);drawHomeM0nkaIcon(240,145);drawHomeWeatherIcon(391,145);
    tft.setTextDatum(middle_center);tft.setTextSize(2);tft.setTextColor(TFT_WHITE);
    tft.drawString("RADIO",89,215);tft.drawString("M0NKA",240,215);tft.drawString("POGODA",391,215);
    tft.setTextSize(1);tft.setTextColor(0xBDF7);
    tft.drawString("Internet",89,242);tft.drawString("HF / SDR",240,242);tft.drawString("Prognoza",391,242);
    tft.setTextDatum(top_left);return;
  }
  static uint16_t row[HOME_BG_W];
  uint32_t p=0;uint16_t x=0,y=0;
  // Tablica zawiera normalne RGB565. LovyanGFX przy pushImage oczekuje
  // zamienionej kolejności bajtów; bez tego purpura stawała się zielona.
  tft.setSwapBytes(true);
  while(p+1<HOME_BG_RLE_SIZE&&y<HOME_BG_H){
    uint8_t count=pgm_read_byte(HOME_BG_RLE+p++);
    uint8_t index=pgm_read_byte(HOME_BG_RLE+p++);
    uint16_t color=pgm_read_word(HOME_BG_PALETTE+index);
    while(count&&y<HOME_BG_H){
      uint16_t take=min((uint16_t)count,(uint16_t)(HOME_BG_W-x));
      for(uint16_t i=0;i<take;i++)row[x+i]=color;
      x+=take;count-=take;
      if(x==HOME_BG_W){tft.pushImage(0,y,HOME_BG_W,1,row);x=0;y++;}
    }
  }
  tft.setSwapBytes(false);
}

