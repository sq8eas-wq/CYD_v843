}

// Awaryjny odczyt ostatniej pozycji z publicznej strony RadioSpis.
// Pierwszy utwór leży dopiero po około 50 kB HTML. Czytamy strumieniowo
// aż do pierwszego href="/piosenka/", bez przechowywania całej strony.
String fetchRadioSpis(const String& slug) {
  if (!slug.length() || WiFi.status() != WL_CONNECTED) return "";
  WiFiClientSecure client; client.setInsecure(); client.setTimeout(10);
  const char* host = "radiospis.pl";
  if (!client.connect(host, 443)) return "";
  String path = "/stacja/" + slug;
  client.print(String("GET ") + path + " HTTP/1.1\r\nHost: " + host +
               "\r\nUser-Agent: CYDRadio/9\r\nAccept: text/html\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n");
  const String marker = "href=\"/piosenka/";
  uint8_t matched = 0; bool linkFound = false, textStarted = false;
  String title; title.reserve(220);
  uint32_t deadline = millis() + 25000;
  uint32_t bytesRead = 0;
  while ((int32_t)(deadline - millis()) > 0 && title.length() < 240) {
    if (!client.available()) {
      if (!client.connected()) break;
      delay(1); yield(); continue;
    }
    char c = (char)client.read();
    bytesRead++;
    if ((bytesRead & 511) == 0) yield();
    if (!linkFound) {
      if (c == marker.charAt(matched)) {
        matched++;
        if (matched == marker.length()) linkFound = true;
      } else matched = (c == marker.charAt(0)) ? 1 : 0;
    } else if (!textStarted) {
      if (c == '>') textStarted = true;
    } else {
      if (c == '<') break;
      title += c;
    }
  }
  title = cleanHtmlText(title);
  if (title.length() >= 5 && title.length() <= 220 && title.indexOf(" - ") > 0) return title;
  return "";
}

String hexByte(uint8_t value) {
  const char* digits = "0123456789ABCDEF";
  String out; out += digits[(value >> 4) & 15]; out += digits[value & 15]; return out;
}

String probeClient(Client& client, const ParsedUrl& p) {
  String out; out.reserve(4200);
  client.print(String("GET ") + p.path + " HTTP/1.1\r\nHost: " + p.host +
               "\r\nUser-Agent: CYDRadioDiag/9\r\nIcy-MetaData: 1\r\nConnection: close\r\n\r\n");
  uint32_t deadline = millis() + 7000;
  int metaInt = -1;
  out += "--- SUROWE NAGŁÓWKI HTTP / ICY ---\n";
  while ((int32_t)(deadline - millis()) > 0) {
    if (!client.connected() && !client.available()) { out += "[połączenie zamknięte przed nagłówkami]\n"; return out; }
    if (!client.available()) { delay(1); yield(); continue; }
    String line = client.readStringUntil('\n'); line.trim();
    if (!line.length()) break;
    if (out.length() < 2600) out += line + "\n";
    if (line.substring(0, 12).equalsIgnoreCase("icy-metaint:")) metaInt = line.substring(12).toInt();
  }
  out += "\nicy-metaint odczytany: " + String(metaInt) + "\n";
  out += "\n--- PIERWSZE 64 BAJTY AUDIO (HEX) ---\n";
  int remaining = metaInt > 0 ? metaInt : 64;
  uint8_t shown = 0;
  while (remaining > 0 && (int32_t)(deadline - millis()) > 0) {
    if (!client.available()) { if (!client.connected()) break; delay(1); yield(); continue; }
    int b = client.read(); remaining--;
    if (shown < 64 && b >= 0) {
      out += hexByte((uint8_t)b) + ' '; shown++;
      if ((shown & 15) == 0) out += '\n';
    }
  }
  if (!shown) out += "[brak danych audio]\n";
  out += "\n--- SUROWY BLOK METADANYCH ---\n";
  if (metaInt <= 0) { out += "Strumień nie podał nagłówka icy-metaint.\n"; return out; }
  while (!client.available() && (int32_t)(deadline - millis()) > 0) { delay(1); yield(); }
  if (!client.available()) { out += "Brak bajtu długości metadanych.\n"; return out; }
  int metaLength = client.read() * 16;
  out += "Długość bloku: " + String(metaLength) + " bajtów\n";
  String rawMeta; rawMeta.reserve(metaLength > 600 ? 600 : metaLength);
  while (metaLength-- > 0 && (int32_t)(deadline - millis()) > 0) {
    if (client.available()) { char c = (char)client.read(); if (c && rawMeta.length() < 600) rawMeta += c; }
    else { delay(1); yield(); }
  }
  out += rawMeta.length() ? rawMeta : "[pusty blok]";
  out += "\n";
  return out;
}

String probeStream(const String& url) {
  ParsedUrl p = parseUrl(url);
  if (!p.ok) return "Nieprawidłowy adres strumienia.\n";
  if (p.tls) {
    WiFiClientSecure client; client.setInsecure(); client.setTimeout(7);
    if (!client.connect(p.host.c_str(), p.port)) return "Nie udało się połączyć TLS ze strumieniem.\n";
    return probeClient(client, p);
  }
  WiFiClient client; client.setTimeout(7);
  if (!client.connect(p.host.c_str(), p.port)) return "Nie udało się połączyć ze strumieniem.\n";
  return probeClient(client, p);
}

