// ------------------------ lokalny panel CYD ------------------------
String lcdSafe(String s) {
  s.replace("ą","a"); s.replace("ć","c"); s.replace("ę","e"); s.replace("ł","l");
  s.replace("ń","n"); s.replace("ó","o"); s.replace("ś","s"); s.replace("ź","z"); s.replace("ż","z");
  s.replace("Ą","A"); s.replace("Ć","C"); s.replace("Ę","E"); s.replace("Ł","L");
  s.replace("Ń","N"); s.replace("Ó","O"); s.replace("Ś","S"); s.replace("Ź","Z"); s.replace("Ż","Z");
  return s;
}

void setRgb(uint8_t state) {
  // Dioda RGB w CYD jest sterowana stanem niskim.
  digitalWrite(RGB_R, HIGH); digitalWrite(RGB_G, HIGH); digitalWrite(RGB_B, HIGH);
  if (state == LED_PLAY) digitalWrite(RGB_G, LOW);
  else if (state == LED_BUFFER) { digitalWrite(RGB_R, LOW); digitalWrite(RGB_G, LOW); }
  else if (state == LED_ERROR) digitalWrite(RGB_R, LOW);
  else if (state == LED_READY) digitalWrite(RGB_B, LOW);
}

void button(int x, int y, int w, int h, const String& label, uint16_t color = 0x11E8) {
  // v7.2: metaliczny, przestrzenny przycisk wspólny dla wszystkich aplikacji.
