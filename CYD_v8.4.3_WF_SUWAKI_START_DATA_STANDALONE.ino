uint16_t blend565(uint16_t a,uint16_t b,uint8_t t){
  uint32_t ar=(a>>11)&31,ag=(a>>5)&63,ab=a&31,br=(b>>11)&31,bg=(b>>5)&63,bb=b&31;
  uint32_t r=(ar*(255-t)+br*t)/255,g=(ag*(255-t)+bg*t)/255,bl=(ab*(255-t)+bb*t)/255;
  return (r<<11)|(g<<5)|bl;
}

