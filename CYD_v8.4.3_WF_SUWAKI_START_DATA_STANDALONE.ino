void m0Loop(){
  uint32_t us=micros();uint32_t now=millis();
  static uint32_t ft8LeaseAt=0;if(m0Page==M0_FT8&&m0WsConnected&&now-ft8LeaseAt>20000UL){ft8LeaseAt=now;m0SetFt8ViewWanted(true);}
  if(m0RemoteHost.length()&&!m0ForceRemote&&!m0WsConnected&&m0DisconnectedSince&&now-m0DisconnectedSince>6000UL){m0ForceRemote=true;m0ws.disconnect();m0WsStarted=false;m0State="NET";m0StartWs();}
  // Dotyk ma pierwszenstwo przed odbiorem kolejnej paczki sieciowej.
  m0HandleTouch();if(appMode!=APP_M0NKA)return;
  m0TryStartRuntime();
  if(m0StartDeferred){static uint32_t waitHdr=0;if(now-waitHdr>600){waitHdr=now;m0State="CZEKAM NA RAM";m0UpdateHeaderDynamic(true);}delay(1);return;}
  m0StartWs();if(!m0WsConnectBusy)m0ws.loop();m0DrawPendingWaterfall();m0DrawPendingCwWaterfall();
  if(m0AprsTaskReady){m0AprsTaskReady=false;if(m0Page==M0_APRS&&!m0SettingsOpen&&!m0DiagOpen)m0DrawAprsPage();}
  if(m0DataTaskReady){m0DataTaskReady=false;if(m0Page==M0_SPOTS)m0DrawSpotsPage();else if(m0Page==M0_FT8)m0DrawFt8Page();}
  if(m0DxDirty&&m0Page==M0_WATERFALL&&!m0SettingsOpen&&!m0DiagOpen&&!m0KeypadOpen){m0DxDirty=false;m0DrawDxBandList();m0DrawWfBottomControls();}
  if(m0UiDirty&&!m0SettingsOpen&&!m0DiagOpen&&!m0KeypadOpen){
    m0UiDirty=false;if(m0Page==M0_WATERFALL){m0DrawFreqInfo();m0DrawScale();m0DrawDxBandList();m0DrawWfBottomControls();}else if(m0Page==M0_CW){static uint32_t cwAt=0;if(now-cwAt>250){cwAt=now;m0DrawCwLive();}}m0UpdateHeaderDynamic();
  }
  if(m0Page==M0_WATERFALL&&!m0SettingsOpen&&!m0DiagOpen&&!m0KeypadOpen&&now-m0LastSmeterDraw>=300){m0LastSmeterDraw=now;m0DrawSmeterOnly();}
  static uint32_t hdr=0;if(now-hdr>1000){hdr=now;m0UpdateHeaderDynamic();}
  m0LastLoopUs=micros()-us;m0LoopUsMax=max(m0LoopUsMax,m0LastLoopUs);m0LoopCount++;delay(1);
}
