    while(count&&y<HOME_BG_H){uint16_t take=min((uint16_t)count,(uint16_t)(HOME_BG_W-x));for(uint16_t i=0;i<take;i++)row[x+i]=color;x+=take;count-=take;if(x==HOME_BG_W){if(y>=y0&&y<y0+h)tft.pushImage(x0,y,w,1,row+x0);x=0;y++;}}
