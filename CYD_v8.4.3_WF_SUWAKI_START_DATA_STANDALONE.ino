// Przestrzenne symbole przygotowane w tej samej stylistyce co wzorzec HOME.
// Dekodowanie indeksow zajmuje 9 kB RAM niezaleznie od wielkosci ikony.
void drawWeatherSprite(int cx,int cy,int size,int code,bool isDay,uint16_t bg){
  (void)bg;
  uint8_t icon=weatherSpriteIndex(code,isDay);
  const uint8_t* data=WEATHER_ICON_RLE[icon];
  uint32_t dataSize=WEATHER_ICON_RLE_SIZE[icon];
  static uint8_t src[96*96];
  static uint16_t row[112];
  uint32_t p=0,out=0;
  while(p+1<dataSize&&out<96UL*96UL){
    uint8_t count=pgm_read_byte(data+p++),value=pgm_read_byte(data+p++);
    while(count--&&out<96UL*96UL)src[out++]=value;
  }
  size=constrain(size,24,112);int x0=cx-size/2,y0=cy-size/2;
  tft.setSwapBytes(true);
  for(int y=0;y<size;y++){
    int sy=y*96/size;
    for(int x=0;x<size;x++){
      uint8_t pi=src[sy*96+x*96/size];
      row[x]=pi?pgm_read_word(WEATHER_ICON_PALETTE+pi):0;
    }
    // Wysylamy tylko nieprzezroczyste odcinki, aby nie powstawal kwadrat
    // na gradientowym tle kafelka HOME.
    for(int x=0;x<size;){
      while(x<size&&!row[x])x++;int start=x;
      while(x<size&&row[x])x++;
      if(x>start)tft.pushImage(x0+start,y0+y,x-start,1,row+start);
    }
  }
  tft.setSwapBytes(false);
}

void drawWeatherIcon(int cx,int cy,int size,int code,bool isDay){
  int z=max(10,size);
  bool rain=(code>=51&&code<=67)||(code>=80&&code<=82);
  bool snow=(code>=71&&code<=77)||(code>=85&&code<=86);
  bool storm=code>=95;
  bool fog=code==45||code==48;
  bool cloudy=code>=1 && !fog && !rain && !snow && !storm;
  bool someCloud=(code==1||code==2);

  // Słońce występuje wyłącznie w pogodny dzień. Noc zawsze używa księżyca.
  if(code<=2){
    int sx=cx-(someCloud?z/5:0),sy=cy-z/8;
    if(isDay){
      for(int a=0;a<360;a+=45){float r=a*PI/180.0f;tft.drawLine(sx+cosf(r)*z*.31f,sy+sinf(r)*z*.31f,sx+cosf(r)*z*.42f,sy+sinf(r)*z*.42f,0xFD20);}
      tft.fillCircle(sx+2,sy+3,z/4,0xCBE0);tft.fillCircle(sx,sy,z/4,0xFFE0);tft.fillCircle(sx-z/12,sy-z/12,z/9,0xFFFF);
    }else{
      tft.fillCircle(sx+2,sy+3,z/4,0x294D);tft.fillCircle(sx,sy,z/4,0xFFDF);
      tft.fillCircle(sx+z/10,sy-z/12,z/4,0x020B);
