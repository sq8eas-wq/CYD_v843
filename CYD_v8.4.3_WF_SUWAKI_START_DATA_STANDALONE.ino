String radioStatusText() {
  if (WiFi.status() != WL_CONNECTED) return "STATUS: CZEKAM NA WIFI";
  if (nativeUserStopped) return "STATUS: PAUZA";
  if (autoRecoverPending) {
    long left=(long)(autoRecoverDueAt-millis()); if(left<0) left=0;
    return "STATUS: AUTO-RECOVERY | " + String((left+999)/1000) + " s";
  }
  if (nativeConnecting) {
    uint32_t sec=(millis()-nativeConnectAt)/1000;
    if (!nativeAudioProgress) return "STATUS: LACZENIE | zrodlo " + String(nativeSource+1) + "/" + String(max((uint8_t)1,nativeSourceCount)) + " | " + String(sec) + " s";
    return "STATUS: BUFOROWANIE " + String(bufferPercent()) + "% | zrodlo " + String(nativeSource+1) + "/" + String(max((uint8_t)1,nativeSourceCount)) + " | " + String(sec) + " s";
  }
  if (nativePlaying) {
    String x="STATUS: ODTWARZANIE | bufor " + String(bufferPercent()) + "%";
    if (bufferRisk==BUFFER_CAUTION) x += " | UWAGA";
    else if (bufferRisk==BUFFER_CRITICAL) x += " | RYZYKO";
    return x;
  }
  return "STATUS: GOTOWE";
}

