void handleWeatherTouch(){
  uint16_t x,y;
  if(!tft.getTouch(&x,&y)||millis()-uiLastTouch<220)return;
  uiLastTouch=millis();

  // Ustawienia pogody: powrot, wybor miasta, odswiezenie i HOME.
  if(weatherSettingsOpen){
    if(y<=36&&x>=390){
      weatherSettingsOpen=false;
      weatherView=WEATHER_MAIN;
      drawWeather();
      return;
    }
    if(y>=80&&y<=144&&!weatherTaskBusy){
      int8_t selected=-1;
      if(x>=20&&x<=155)selected=0;
      else if(x>=172&&x<=307)selected=1;
      else if(x>=324&&x<=459)selected=2;
      if(selected>=0&&selected!=weatherCity){
        weatherCity=(uint8_t)selected;
        prefs.putUChar("wcity",weatherCity);
        weather.refreshedAt=0;
        weatherLastAttemptAt=0;
        weather.status="Pobieranie...";
        drawWeatherSettings();
        startWeatherRefresh();
      }
      return;
    }
    if(y>=168&&y<=224){
      if(x>=20&&x<=230){
        if(!weatherTaskBusy){
          weatherLastAttemptAt=0;
          startWeatherRefresh();
          drawWeatherSettings();
        }
        return;
      }
      if(x>=250&&x<=459){
        weatherSettingsOpen=false;
        weatherView=WEATHER_MAIN;
        appMode=APP_HOME;
        drawMainMenu();
        return;
      }
    }
    return;
  }

  // Widok godzinowy i dniowy maja wspolny przycisk WROC.
  if(weatherView==WEATHER_HOURLY||weatherView==WEATHER_DAYS){
    if(y<=36&&x<=80){
      weatherView=WEATHER_MAIN;
      drawWeather();
    }
    return;
  }

  // Glowny ekran pogody.
  if(y<=36){
    if(x<=75){
      appMode=APP_HOME;
      drawMainMenu();
      return;
    }
    if(x>=405){
      weatherSettingsOpen=true;
      drawWeatherSettings();
      return;
    }
  }
  if(y>=132&&y<=174){
    if(x>=8&&x<=189){
      weatherView=WEATHER_HOURLY;
      drawWeatherHourly();
      return;
    }
    if(x>=197&&x<=378){
      weatherView=WEATHER_DAYS;
      drawWeatherDays();
      return;
    }
  }
}

void weatherLoop(){server.handleClient();if(audio)audio->loop();updateBrightness();updateBatteryMonitor();handleWeatherTouch();uint32_t now=millis();if(weatherTaskReady){weatherTaskReady=false;drawWeather();}bool due=weather.refreshedAt?(now-weather.refreshedAt>600000UL):(!weatherLastAttemptAt||now-weatherLastAttemptAt>60000UL);if(!weatherTaskBusy&&due&&(!nativePlaying||bufferAllowsBackground(false)))startWeatherRefresh();if(now-weatherLastDraw>1000UL){weatherLastDraw=now;updateWeatherClock();}}

