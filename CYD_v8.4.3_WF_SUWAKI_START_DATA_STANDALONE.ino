  out += "Opis źródła: "; if (metaCacheSource[id].length()) out += metaCacheSource[id]; else out += "[brak]"; out += '\n';
  out += "Wiek pamięci podręcznej: " + String(metaCacheAt[id] ? (millis() - metaCacheAt[id]) / 1000 : 0) + " s\n\n";
  out += "--- ADRESY AUDIO ---\n";
