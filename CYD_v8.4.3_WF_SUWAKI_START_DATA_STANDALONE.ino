uint8_t weatherSpriteIndex(int code,bool isDay){
  if(code==0)return isDay?0:1;
  if(code<=2)return isDay?2:1;
  if(code==45||code==48)return 7;
  if(code>=95)return 5;
  if((code>=71&&code<=77)||(code>=85&&code<=86))return 6;
  if((code>=51&&code<=67)||(code>=80&&code<=82))return 4;
  return 3;
