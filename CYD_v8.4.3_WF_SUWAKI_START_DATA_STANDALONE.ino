  if (!nativeFast) addNativeSource(nativeLowUrl(id));
}

// Radio VIA nie umieszcza nazwy audycji w ICY. Oficjalny odtwarzacz
// udostępnia ją przez lekkie zapytanie AJAX, więc pobieramy ją osobno.
String fetchViaProgram() {
  if (WiFi.status() != WL_CONNECTED) return "";
  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(4);
  const char* host = "radiovia.com.pl";
  if (!client.connect(host, 443)) return "";
  String post = "action=get_current_audition";
  client.print(String("POST /wp-admin/admin-ajax.php HTTP/1.1\r\nHost: ") + host +
               "\r\nUser-Agent: CYDRadio/9\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " +
               String(post.length()) + "\r\nConnection: close\r\n\r\n" + post);
  String raw;
  raw.reserve(1800);
  uint32_t deadline = millis() + 4500;
  while ((int32_t)(deadline - millis()) > 0 && raw.length() < 3500) {
    while (client.available() && raw.length() < 3500) raw += (char)client.read();
    if (!client.connected() && !client.available()) break;
    delay(1); yield();
  }
  int current = raw.indexOf("\"current\"");
  int key = raw.indexOf("\"title\"", current >= 0 ? current : 0);
  if (key < 0) return "";
  int colon = raw.indexOf(':', key);
  int first = raw.indexOf('"', colon + 1);
  if (first < 0) return "";
  String title;
  bool escaped = false;
  for (int i = first + 1; i < (int)raw.length(); i++) {
    char c = raw.charAt(i);
    if (!escaped && c == '"') break;
    if (!escaped && c == '\\') { escaped = true; continue; }
    title += c; escaped = false;
  }
  title.trim();
  return title;
}

